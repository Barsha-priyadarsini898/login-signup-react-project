# Server Port
PORT=5000

# Client URL (for CORS and reset links)
CLIENT_URL=http://localhost:5173

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789

# ========================================================
# Supabase Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
# ========================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ========================================================
# Nodemailer / SMTP Configuration
# If left empty, Nodemailer will auto-generate an Ethereal Test Account
# or display instant email previews in the built-in Mail Drawer!
# ========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AuthSphere Security <no-reply@authsphere.io>"
